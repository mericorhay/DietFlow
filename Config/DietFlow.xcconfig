// Build settings for the app target.
//
// Identity lives here rather than inside project.pbxproj so it is readable in a
// diff and editable without opening Xcode.

#include "Shared.xcconfig"

PRODUCT_NAME = DietFlow
PRODUCT_BUNDLE_IDENTIFIER = com.orhay.dietflow
// App Group shared with the widget: the plan file both of them read.
CODE_SIGN_ENTITLEMENTS = DietFlow/DietFlow.entitlements

SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

ENABLE_PREVIEWS = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// The display name is localised in Resources/InfoPlist.xcstrings; this is the English source.
INFOPLIST_KEY_CFBundleDisplayName = DietFlow
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.healthcare-fitness
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
