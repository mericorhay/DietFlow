default_platform(:ios)

# Must match PRODUCT_BUNDLE_IDENTIFIER in Config/DietFlowWidget.xcconfig.
WIDGET_IDENTIFIER = "com.orhay.dietflow.widget"

# Authenticate with App Store Connect via the API key, never an Apple ID.
# The workflow passes the key's three parts as secrets. The key secret may hold
# the raw .p8 text or a base64 blob of it depending on how it was pasted into
# GitHub — detect rather than guess.
def connect_api_key
  key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY")
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: key_content,
    is_key_content_base64: !key_content.include?("BEGIN PRIVATE KEY"),
    in_house: false,
  )
end

# Read the display name out of an encrypted .mobileprovision. Only the name is
# taken from the profile — the bundle ids come from the Appfile and the constant
# above, the same values Xcode builds, so there is nothing to disagree about.
def profile_name(path)
  sh("security cms -D -i '#{path}' | plutil -extract Name raw -", log: false).strip
end

# Version and build live in an xcconfig shared by the app and its widget, not in the pbxproj.
def shared_setting(name)
  xcconfig = File.read(File.expand_path("../Config/Shared.xcconfig", __dir__))
  xcconfig[/^#{name}\s*=\s*(\S+)/, 1] or UI.user_error!("#{name} is missing from Config/Shared.xcconfig")
end

platform :ios do
  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    api_key = connect_api_key
    team_id = ENV["APPLE_TEAM_ID"] || "XYB3NLV654"

    # CI has no keychain and no certificates; a dev Mac already has both.
    if ENV["CI"]
      setup_ci
      import_certificate(
        certificate_path: ENV.fetch("IOS_CERT_PATH"),
        certificate_password: ENV.fetch("IOS_CERTIFICATE_PASSWORD"),
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: "",
      )
    end

    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    # The app and the widget extension are two bundle ids, so two profiles. Names are read off
    # the profiles actually being installed rather than hardcoded: a UUID stops matching the
    # moment a profile is regenerated, which happens every time a certificate changes.
    signing = {
      "DietFlow" => { id: app_id, path: ENV.fetch("IOS_PROFILE_PATH") },
      "DietFlowWidget" => { id: WIDGET_IDENTIFIER, path: ENV.fetch("IOS_WIDGET_PROFILE_PATH") },
    }
    signing.each do |target, entry|
      install_provisioning_profile(path: entry[:path])
      entry[:profile] = profile_name(entry[:path])
      UI.message("Signing #{entry[:id]} with profile '#{entry[:profile]}' (team #{team_id})")

      # Scoped to one target. This rewrites the checked-out project.pbxproj on the runner, which
      # is discarded with the workspace at job end — nothing is committed, so the project keeps
      # Automatic signing for anyone opening it.
      update_code_signing_settings(
        path: "DietFlow.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: entry[:profile],
        bundle_identifier: entry[:id],
      )
    end

    # GitHub's workflow run counter is local to this workflow and can be lower than a build
    # already uploaded from Xcode or another pipeline. App Store Connect is the authority:
    # always continue the current marketing version's build train from the greatest number
    # Apple has accepted. The checked-in build number is honoured and only ever raised.
    version = shared_setting("MARKETING_VERSION")
    uploaded_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_id,
      version: version,
      initial_build_number: 0,
    ).to_i
    configured_build = shared_setting("CURRENT_PROJECT_VERSION").to_i
    build_number = [uploaded_build + 1, configured_build].max
    UI.success("Building DietFlow #{version} (#{build_number}); latest TestFlight build is #{uploaded_build}")

    build_app(
      project: "DietFlow.xcodeproj",
      scheme: "DietFlow",
      configuration: "Release",
      output_directory: "build",
      output_name: "DietFlow.ipa",
      export_method: "app-store",
      # Passed on the command line so the app and the widget get the same number.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: signing.values.to_h { |entry| [entry[:id], entry[:profile]] },
        compileBitcode: false,
        uploadBitcode: false,
        uploadSymbols: true,
      },
    )

    # Wait for App Store Connect to finish processing. With
    # skip_waiting_for_build_processing:true a binary that fails processing
    # leaves the run green while nothing ever shows up in TestFlight. Waiting
    # costs ~10-20 min but turns that into a red run with the real reason.
    groups = (ENV["TESTFLIGHT_GROUPS"] || "").split(",").map(&:strip).reject(&:empty?)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
      groups: groups.empty? ? nil : groups,
    )
  end
end
