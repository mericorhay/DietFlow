    "intent.addMeal.description" : {
      "comment" : "Description of the Add Meal action. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt deinem aktiven Plan am gewählten Tag eine Mahlzeit hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a meal to your active plan on the chosen day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una comida a tu plan activo en el día elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un repas à votre plan actif le jour choisi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen güne, etkin planına bir öğün ekler."
          }
        }
      }
    },
    "intent.addMeal.noPlan" : {
