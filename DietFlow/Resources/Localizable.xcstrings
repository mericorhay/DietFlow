    "error.save.message" : {
      "comment" : "Message of the alert shown when a change could not be stored. One short sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your change wasn’t saved. Please try again."
          }
