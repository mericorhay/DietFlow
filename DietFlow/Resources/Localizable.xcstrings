        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişikliğin kaydedilmedi. Lütfen tekrar dene."
          }
        }
      }
    },
    "error.save.ok" : {
      "comment" : "Button that closes the could-not-save alert. One word.",
