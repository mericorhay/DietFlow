          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neuen Rezepte für diesen Zeitraum sind aufgebraucht; bereits geöffnete bleiben erhalten. Am %@ gibt es wieder neue."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This period's new recipes are used up; the ones you opened stay. More come back on %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las recetas nuevas de este periodo se han agotado; las que abriste siguen ahí. Vuelven más el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles recettes de cette période sont épuisées ; celles que vous avez ouvertes restent. Il y en aura d’autres le %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dönemin yeni tarifleri bitti; açtıkların duruyor. %@ tarihinde yenilenir."
          }
        }
      }
    },
