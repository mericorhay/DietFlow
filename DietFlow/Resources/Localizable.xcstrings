  "strings" : {
    "intent.addMeal.description" : {
      "comment" : "Description of the Add Meal action. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a meal to your active plan on the chosen day."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen güne, etkin planına bir öğün ekler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una comida a tu plan activo en el día elegido."
          }
        }
      }
    },
    "intent.addMeal.noPlan" : {
      "comment" : "Siri reply when there is no plan to add a meal to. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a meal plan first."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce bir öğün planı oluştur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero crea un plan de comidas."
          }
        }
      }
    },
