    "error.save.message" : {
      "comment" : "Message of the alert shown when a change could not be stored. One short sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderung wurde nicht gespeichert. Bitte versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your change wasn’t saved. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cambio no se guardó. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre modification n’a pas été enregistrée. Veuillez réessayer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişikliğin kaydedilmedi. Lütfen tekrar dene."
          }
        }
      }
    },
