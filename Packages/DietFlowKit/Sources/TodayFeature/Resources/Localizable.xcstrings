{
  "sourceLanguage" : "en",
  "strings" : {
    "today.a11y.markDone" : {
      "comment" : "VoiceOver label of a timeline row's status circle, which records the meal as eaten. %@ is the meal's name, e.g. 'Caesar salad'.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ als erledigt markieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark %@ done"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcar %@ como hecha"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquer %@ comme terminé"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için Yedim olarak işaretle"
          }
        }
      }
    },
    "today.a11y.markNotDone" : {
