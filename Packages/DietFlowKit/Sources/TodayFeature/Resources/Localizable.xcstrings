    "today.morning.late.message" : {
      "comment" : "Today, late-start card, under the title: what shifting the day does. Calm, no promises about health.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Mahlzeiten können sich an den Rest des heutigen Tages anpassen. Das Abendessen bleibt nah an seiner Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your meals can move to fit the rest of today. Dinner stays close to its time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus comidas pueden moverse para encajar en el resto del día. La cena se queda cerca de su hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos repas peuvent se décaler pour s’adapter au reste de la journée. Le dîner reste proche de son heure."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğünlerin günün geri kalanına göre kayabilir. Akşam yemeği saatine yakın kalır."
          }
        }
      }
