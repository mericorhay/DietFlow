    "today.estimate.subtitle" : {
      "comment" : "Today, assistant card subtitle: what the estimate does and how it is shown. Must keep the ≈ sign.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent schätzt Kalorien, Eiweiß, Kohlenhydrate und Fett anhand des Namens jeder Mahlzeit. Angezeigt mit ≈; die Werte deiner Ernährungsberatung werden nie geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The assistant estimates calories, protein, carbs and fat from each meal's name. Shown with ≈; your dietitian's own figures are never changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente estima calorías, proteínas, carbohidratos y grasas a partir del nombre de cada comida. Se muestran con ≈; las cifras de tu dietista nunca cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant estime les calories, les protéines, les glucides et les lipides d’après le nom de chaque repas. Affichés avec ≈ ; les chiffres de votre diététicien(ne) ne sont jamais modifiés."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistan her öğünün adından kalori, protein, karbonhidrat ve yağı tahmin eder. ≈ ile gösterilir; diyetisyeninin verdiği değerler asla değişmez."
          }
        }
      }
    },
