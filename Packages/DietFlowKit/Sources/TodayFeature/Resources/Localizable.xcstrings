      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine erste Mahlzeit gibt es eine halbe Stunde nach dem Aufstehen. Der Rest des Tages folgt, und das Abendessen bleibt nah an seiner Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first meal goes half an hour after you got up. The rest of the day follows, and dinner stays close to its time."
