    "today.plus.message" : {
      "comment" : "Today, card about the paid tier, for free users: what it adds and that the rest stays free. No price. %1$lld recipes, %2$lld nutrition estimates, %3$lld written plans a month (all large numbers, e.g. 120, 100, 60).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Monat mehr vom Assistenten: %1$lld Rezepte, %2$lld Nährwertschätzungen und %3$lld geschriebene Pläne, dazu Platz für mehr als einen Plan. Dein Plan, deine Widgets und Erinnerungen bleiben in jedem Fall kostenlos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More from the assistant every month: %1$lld recipes, %2$lld nutrition estimates and %3$lld written plans, and room for more than one plan. Your plan, widgets and reminders stay free either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más del asistente cada mes: %1$lld recetas, %2$lld estimaciones de nutrición y %3$lld planes escritos, y espacio para más de un plan. Tu plan, tus widgets y tus recordatorios siguen siendo gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de l’assistant chaque mois : %1$lld recettes, %2$lld estimations nutritionnelles et %3$lld plans rédigés, et de la place pour plus d’un plan. Votre plan, vos widgets et vos rappels restent gratuits dans tous les cas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ay asistandan daha fazlası: %1$lld tarif, %2$lld besin değeri tahmini ve %3$lld plan yazımı, üstelik birden fazla plan tutabilirsin. Planın, widget'ların ve hatırlatmaların her durumda ücretsiz kalır."
          }
        }
      }
    },
