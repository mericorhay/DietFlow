{
  "sourceLanguage" : "en",
  "strings" : {
    "widgets.add.header" : {
      "comment" : "Section heading over the three steps that add the widget. A few words.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Home-Bildschirm hinzufügen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add to Home Screen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir a la pantalla de inicio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter à l’écran d’accueil"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Ekran'a Ekle"
          }
        }
      }
    },
    "widgets.add.lockHeader" : {
      "comment" : "Section heading over the steps, while the Lock Screen preview is selected. A few words.",
