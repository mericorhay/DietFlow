    "widgets.timing.footer" : {
      "comment" : "Widgets tab: footer under the timing settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Zeit einer Mahlzeit gekommen ist, bleibt sie so lange im Widget, dann übernimmt die nächste. Du musst nichts antippen. Mit „Gegessen“ geht es früher weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a meal's time comes it stays on the widget for this long, then the next one takes its place. Nothing needs tapping. The Eaten button is for moving on sooner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando llega la hora de una comida, se queda en el widget este tiempo y luego da paso a la siguiente. No hace falta tocar nada. El botón Comida hecha sirve para pasar antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand l’heure d’un repas arrive, il reste sur le widget pendant cette durée, puis le suivant prend sa place. Rien à toucher. Le bouton Mangé sert à passer plus tôt au suivant."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğünün saati geldiğinde widget'ta bu süre boyunca kalır, sonra yerini sıradaki öğün alır. Hiçbir şeye dokunman gerekmez. Yedim düğmesi daha erken geçmek içindir."
          }
        }
      }
    },
