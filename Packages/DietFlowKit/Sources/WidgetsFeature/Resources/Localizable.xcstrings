            "value" : "Widget hinzufügen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a Widget"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir un widget"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter un widget"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget Ekle"
          }
        }
      }
    },
    "widgets.add.smartStack" : {
      "comment" : "Widgets tab: footer under the steps for adding the widget. %@ is the app's name. A Smart Stack is the iOS stack of widgets that turns by itself.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einem Smart-Stapel kommt %@ zu den Essenszeiten von selbst nach oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a Smart Stack, %@ comes to the top by itself at mealtimes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una pila inteligente, %@ sube sola arriba a la hora de comer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans une pile intelligente, %@ passe au premier plan tout seul aux heures des repas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıllı Yığın’da %@, öğün saatlerinde kendiliğinden en üste çıkar."
          }
        }
      }
    },
    "widgets.add.step1" : {
      "comment" : "Step 1 of adding the widget. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berühre einen leeren Bereich deines Home-Bildschirms oder Sperrbildschirms und halte ihn gedrückt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold an empty area of your Home Screen or Lock Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una zona vacía de la pantalla de inicio o de bloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur une zone vide de votre écran d’accueil ou de verrouillage."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Ekran'da veya Kilit Ekranı'nda boş bir alana dokunup basılı tut."
          }
        }
      }
    },
    "widgets.add.step2" : {
      "comment" : "Step 2 of adding the widget. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Bearbeiten“ und dann auf „Widget hinzufügen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Edit, then Add Widget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Editar y luego Añadir widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Modifier, puis Ajouter un widget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenle'ye, ardından Widget Ekle'ye dokun."
          }
        }
      }
    },
    "widgets.add.step3" : {
      "comment" : "Step 3 of adding the widget. %@ is the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nach %@ und wähle eine Größe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for %@ and pick a size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca %@ y elige un tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherchez %@ et choisissez une taille."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulamasını ara ve bir boyut seç."
          }
        }
      }
    },
    "widgets.installed" : {
      "comment" : "Shown instead of the setup steps once a widget has been added. One sentence.",
