{
  "sourceLanguage" : "en",
  "strings" : {
    "widgets.add.header" : {
      "comment" : "Section heading over the three steps that add the widget. A few words.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add to Home Screen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Ekran'a Ekle"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir a la pantalla de inicio"
          }
        }
      }
    },
    "widgets.add.lockHeader" : {
      "comment" : "Section heading over the steps, while the Lock Screen preview is selected. A few words.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a Widget"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget Ekle"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir un widget"
          }
        }
      }
    },
    "widgets.add.step1" : {
      "comment" : "Step 1 of adding the widget. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold an empty area of your Home Screen or Lock Screen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Ekran'da veya Kilit Ekranı'nda boş bir alana dokunup basılı tut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una zona vacía de la pantalla de inicio o de bloqueo."
          }
        }
      }
    },
    "widgets.add.step2" : {
      "comment" : "Step 2 of adding the widget. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Edit, then Add Widget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenle'ye, ardından Widget Ekle'ye dokun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Editar y luego Añadir widget."
          }
        }
      }
    },
    "widgets.add.step3" : {
      "comment" : "Step 3 of adding the widget. %@ is the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for %@ and pick a size."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulamasını ara ve bir boyut seç."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca %@ y elige un tamaño."
          }
        }
      }
    },
    "widgets.installed" : {
      "comment" : "Shown instead of the setup steps once a widget has been added. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your widget is on your Home Screen."
