    "widgets.timing.footer" : {
      "comment" : "Footer under the timing choices: the widget moves on by itself, and what the Done button is for. Two or three short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a meal's time comes it stays on the widget for this long, then the next one takes its place. Nothing needs tapping. The Done button is for moving on sooner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando llega la hora de una comida, se queda en el widget este tiempo y luego da paso a la siguiente. No hace falta tocar nada. El botón Hecho sirve para pasar antes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğünün saati geldiğinde widget'ta bu süre boyunca kalır, sonra yerini sıradaki öğün alır. Hiçbir şeye dokunman gerekmez. Tamamlandı düğmesi daha erken geçmek içindir."
          }
        }
