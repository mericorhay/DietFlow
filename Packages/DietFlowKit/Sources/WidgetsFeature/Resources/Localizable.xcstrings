    "widgets.look.footer" : {
      "comment" : "Footer under the colour and background choices: where they do not apply. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Sperrbildschirm und auf einem Home-Bildschirm mit getönten Symbolen wählt iOS die Farben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Lock Screen, and on a Home Screen set to tinted icons, iOS chooses the colors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la pantalla de bloqueo, y en una pantalla de inicio con iconos teñidos, iOS elige los colores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’écran de verrouillage, et sur un écran d’accueil réglé sur des icônes teintées, iOS choisit les couleurs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilit ekranında ve renk tonlu simgelere ayarlanmış ana ekranda renkleri iOS belirler."
          }
        }
      }
    },
