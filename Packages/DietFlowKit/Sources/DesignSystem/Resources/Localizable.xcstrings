            "value" : "Dites comment vous voulez manger. L’IA rédige jusqu’à 30 jours."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasıl beslenmek istediğini söyle. Yapay zekâ 30 güne kadar yazar."
          }
        }
      }
