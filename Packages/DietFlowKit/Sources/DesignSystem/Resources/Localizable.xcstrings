    "noPlan.write.subtitle" : {
      "comment" : "Line under the Write Me a Plan button on the screen shown before any plan exists. Says what to do and that AI does the writing. Two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag, wie du essen willst. Die KI schreibt bis zu 30 Tage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say how you want to eat. AI writes up to 30 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di cómo quieres comer. La IA escribe hasta 30 días."
          }
        },
        "fr" : {
          "stringUnit" : {
