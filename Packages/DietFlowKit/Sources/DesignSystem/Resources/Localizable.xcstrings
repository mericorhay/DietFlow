    "assistant.consent.message" : {
      "comment" : "Alert message asking permission before meals are sent to the AI company. %1$@ is the company's name (for example OpenAI), %2$@ the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür werden Name, Beschreibung und Portion der Mahlzeit sowie Lebensmittel, die du meidest, über unseren Server an %1$@ gesendet, dessen KI sie liest. %2$@ speichert sie nicht. Sonst wird nichts über dich oder deinen Plan gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To do this, the meal's name, description and portion, and any foods you said you avoid, are sent through our server to %1$@, whose AI reads them. %2$@ does not keep them. Nothing else about you or your plan is sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ello, el nombre, la descripción y la ración de la comida, y los alimentos que dijiste evitar, se envían a través de nuestro servidor a %1$@, cuya IA los lee. %2$@ no los guarda. No se envía nada más sobre ti ni sobre tu plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour cela, le nom, la description et la portion du repas, ainsi que les aliments que vous évitez, sont envoyés via notre serveur à %1$@, dont l’IA les lit. %2$@ ne les conserve pas. Rien d’autre sur vous ou votre plan n’est envoyé."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun için öğünün adı, açıklaması ve porsiyonu ile yemediğini söylediğin yiyecekler sunucumuz üzerinden %1$@ yapay zekâsına gönderilir. %2$@ bunları saklamaz. Seninle ya da planınla ilgili başka hiçbir şey gönderilmez."
          }
        }
      }
    },
    "assistant.consent.title" : {
      "comment" : "Alert title asking permission before a meal is sent to the AI company. %@ is the company's name (for example OpenAI).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahlzeiten mit %@ teilen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share meals with %@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Compartir las comidas con %@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partager des repas avec %@ ?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğünlerin %@ ile paylaşılsın mı?"
          }
        }
      }
    },
