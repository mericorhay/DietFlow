    "noPlan.message" : {
      "comment" : "Under 'No meal plan yet': what the app does once a plan exists. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege einmal einen Zeitplan an und überlasse den Rest dem Widget."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a schedule once, then let the widget handle the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu horario una vez y deja que el widget se encargue del resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un programme une fois, puis laissez le widget s’occuper du reste."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programını bir kez oluştur, gerisini widget halletsin."
          }
        }
      }
    },
    "noPlan.organize.subtitle" : {
      "comment" : "Line under the Organize Any List button on the screen shown before any plan exists. Two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
