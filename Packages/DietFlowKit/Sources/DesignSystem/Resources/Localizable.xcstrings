{
  "sourceLanguage" : "en",
  "strings" : {
    "assistant.consent.allow" : {
      "comment" : "Button in the permission alert that allows sending meals to the AI company.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin Ver"
          }
        }
      }
    },
    "assistant.consent.decline" : {
      "comment" : "Button in the permission alert that declines sending meals to the AI company, for now.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not Now"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi Değil"
          }
        }
      }
    },
    "assistant.consent.message" : {
      "comment" : "Alert message asking permission before meals are sent to the AI company. %1$@ is the company's name (for example OpenAI), %2$@ the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For AI plans, recipes and nutrition estimates, your submitted text or selected meal details (name, description, portion, type and servings), food exclusions and language are sent via our Cloudflare server to %1$@, only when you request them. %2$@ does not retain this content on its server. OpenAI may retain it for abuse monitoring for up to 30 days, with legal or safety exceptions. You can revoke permission in Settings. See the Privacy Policy for details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al solicitar planes, recetas o estimaciones nutricionales con IA, tu texto o los datos de las comidas seleccionadas (nombre, descripción, ración, tipo y comensales), alimentos que evitas e idioma se envían a %1$@ a través de nuestro servidor de Cloudflare. %2$@ no conserva este contenido en su servidor. OpenAI puede conservarlo hasta 30 días para prevenir abusos, con excepciones legales o de seguridad. Puedes revocar el permiso en Ajustes. Consulta la Política de privacidad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ planı, tarif ve besin tahmini istediğinde, gönderdiğin metin veya seçili öğün bilgileri (ad, açıklama, porsiyon, tür ve kişi sayısı), kaçındığın yiyecekler ve dil tercihin Cloudflare sunucumuz üzerinden %1$@ şirketine iletilir. %2$@ bu içeriği sunucusunda saklamaz. OpenAI, kötüye kullanım denetimi için yasal veya güvenlik istisnaları dışında 30 güne kadar saklayabilir. İznini Ayarlar’dan geri alabilirsin. Ayrıntılar Gizlilik Politikası’nda."
          }
        }
      }
    },
    "assistant.consent.title" : {
      "comment" : "Alert title asking permission before a meal is sent to the AI company. %@ is the company's name (for example OpenAI).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share meals with %@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Compartir las comidas con %@?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğünlerin %@ ile paylaşılsın mı?"
          }
        }
      }
    },
