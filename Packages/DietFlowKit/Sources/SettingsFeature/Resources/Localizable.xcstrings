        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Funktionen genutzt werden und wo etwas schiefgeht, um die App zu verbessern. Nie deine Mahlzeiten, dein Plan oder etwas, das du eingibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which features are used and where things go wrong, to help improve the app. Never your meals, your plan or anything you type."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué funciones se usan y dónde algo falla, para mejorar la app. Nunca tus comidas, tu plan ni nada de lo que escribes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctionnalités utilisées et ce qui ne fonctionne pas, pour aider à améliorer l’app. Jamais vos repas, votre plan ni ce que vous saisissez."
