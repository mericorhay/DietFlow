    "settings.privacy.body" : {
      "comment" : "Privacy note, first paragraph. %@ is the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your plan stays on this iPhone. %@ has no account, no analytics and no advertising, and nothing you enter is sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan se queda en este iPhone. %@ no tiene cuentas, análisis ni publicidad, y nada de lo que escribes se envía a ningún sitio."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planın bu iPhone'da kalır. %@ uygulamasında hesap, analiz ve reklam yoktur; girdiğin hiçbir şey bir yere gönderilmez."
          }
        }
      }
    },
    "settings.privacy.import" : {
      "comment" : "Privacy note, second paragraph: imports are read on the device.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos, PDFs and text you import are read on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos, los PDF y el texto que importas se leen en este iPhone."
