    "settings.privacy.assistant" : {
      "comment" : "Paragraph on the Privacy screen, in builds with the assistant. %@ is the company whose AI reads the text, such as OpenAI.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du den Assistenten nutzt, wird der Text, den du ihm gibst, über unseren Server an %@ gesendet, dessen KI ihn liest und deinen Plan schreibt. Wir speichern ihn nicht. Nichts anderes, was du eingibst, verlässt dein iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you use the assistant, the text you give it is sent through our server to %@, whose AI reads it and writes your plan. We do not store it. Nothing else you type leaves your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando usas el asistente, el texto que le das se envía a través de nuestro servidor a %@, cuya IA lo lee y escribe tu plan. Nosotros no lo guardamos. Nada más de lo que escribes sale de tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous utilisez l’assistant, le texte que vous lui donnez est envoyé via notre serveur à %@, dont l’IA le lit et rédige votre plan. Nous ne le conservons pas. Rien d’autre de ce que vous saisissez ne quitte votre iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistanı kullandığında ona verdiğin metin, sunucumuz üzerinden %@ şirketine gönderilir; onun yapay zekâsı metni okuyup planını yazar. Biz saklamayız. Yazdığın başka hiçbir şey iPhone'undan çıkmaz."
          }
        }
      }
    },
    "settings.privacy.assistantSharing" : {
      "comment" : "Switch on the Privacy screen. On means the person has agreed that the assistant's text is sent to the company whose AI reads it. %@ is that company, such as OpenAI.",
      "extractionState" : "manual",
      "localizations" : {
