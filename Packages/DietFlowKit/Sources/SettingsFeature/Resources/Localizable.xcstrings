    "settings.privacy.body" : {
      "comment" : "Privacy note, first paragraph. %@ is the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your plan stays on this iPhone. %@ has no account, no analytics and no advertising, and nothing you enter is sent anywhere."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planın bu iPhone'da kalır. %@ uygulamasında hesap, analiz ve reklam yoktur; girdiğin hiçbir şey bir yere gönderilmez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan se queda en este iPhone. %@ no tiene cuentas, análisis ni publicidad, y nada de lo que escribes se envía a ningún sitio."
          }
        }
      }
    },
    "settings.privacy.import" : {
      "comment" : "Privacy note, second paragraph: imports are read on the device.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos, PDFs and text you import are read on this iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktardığın fotoğraflar, PDF'ler ve metinler bu iPhone'da okunur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos, los PDF y el texto que importas se leen en este iPhone."
          }
        }
      }
    },
    "settings.privacy.widget" : {
      "comment" : "Privacy note, third paragraph: what the widget can see.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets show your next meals on the Home Screen and Lock Screen, where anyone holding your phone can see them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget'lar sıradaki öğünlerini Ana Ekran'da ve Kilit Ekranı'nda gösterir; telefonunu tutan herkes görebilir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los widgets muestran tus próximas comidas en la pantalla de inicio y de bloqueo, donde cualquiera con tu teléfono puede verlas."
          }
        }
      }
    },
