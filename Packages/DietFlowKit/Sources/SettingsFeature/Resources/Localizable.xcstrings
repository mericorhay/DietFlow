    "settings.plus.assistant" : {
      "comment" : "Footer of the Plus section: how many assistant plans are left in this period and when the count starts again. %1$lld is what is left, %2$lld the allowance, %3$@ a date (\"16 November 2026\").",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übrige Assistenten-Pläne: %1$lld von %2$lld. Am %3$@ sind sie wieder da."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant plans left: %1$lld of %2$lld. They come back on %3$@."
