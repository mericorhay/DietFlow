    "settings.privacy.assistant" : {
      "comment" : "Paragraph on the Privacy screen, in builds with the assistant. %@ is the company whose AI reads the text, such as OpenAI.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Pläne, Rezepte und Nährwertschätzungen senden nach deiner Erlaubnis nur den Text oder die Mahlzeiten, die du auswählst, Lebensmittel, die du meidest, und deine Sprache über unseren Cloudflare-Server an %@. Wir speichern diese Inhalte nicht auf unserem Server. OpenAI kann sie zur Missbrauchserkennung bis zu 30 Tage aufbewahren, mit rechtlichen oder sicherheitsbezogenen Ausnahmen. Widerrufe die Erlaubnis unten; Details findest du in der Datenschutzerklärung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI plans, recipes and nutrition estimates send only the text or meals you select, food exclusions and language through our Cloudflare server to %@ after permission. We do not retain that content on our server. OpenAI may retain it for abuse monitoring for up to 30 days, with legal or safety exceptions. Revoke permission below; see the Privacy Policy for details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planes, recetas y estimaciones nutricionales con IA envían solo el texto o las comidas que seleccionas, alimentos que evitas e idioma a %@ mediante nuestro servidor de Cloudflare, con tu permiso. No conservamos ese contenido en nuestro servidor. OpenAI puede conservarlo hasta 30 días para prevenir abusos, con excepciones legales o de seguridad. Revoca el permiso abajo; consulta la Política de privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans, recettes et estimations nutritionnelles par IA envoient uniquement le texte ou les repas que vous sélectionnez, les aliments que vous évitez et votre langue via notre serveur Cloudflare à %@, après votre autorisation. Nous ne conservons pas ce contenu sur notre serveur. OpenAI peut le conserver jusqu’à 30 jours pour la détection des abus, sauf exceptions légales ou de sécurité. Retirez l’autorisation ci-dessous ; consultez la Politique de confidentialité pour en savoir plus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ planı, tarif ve besin tahmini için yalnızca gönderdiğin metin veya seçtiğin öğünler, kaçındığın yiyecekler ve dil tercihin izin verdikten sonra Cloudflare sunucumuz üzerinden %@ şirketine iletilir. Bu içerik sunucumuzda saklanmaz. OpenAI, kötüye kullanım denetimi için yasal veya güvenlik istisnaları dışında 30 güne kadar saklayabilir. İznini aşağıdan geri alabilirsin; ayrıntılar Gizlilik Politikası’nda."
          }
        }
      }
    },
    "settings.privacy.assistantSharing" : {
      "comment" : "Switch on the Privacy screen. On means the person has agreed that the assistant's text is sent to the company whose AI reads it. %@ is that company, such as OpenAI.",
      "extractionState" : "manual",
