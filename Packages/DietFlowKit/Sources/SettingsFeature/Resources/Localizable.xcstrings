    },
    "settings.privacy.import" : {
      "comment" : "Paragraph on the Privacy screen about importing a plan without the assistant. Names Apple's on-device model, which reads the text where the iPhone has it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, PDFs und Text, die du importierst, werden auf diesem iPhone gelesen, mit dem Modell von Apple auf dem Gerät, sofern dein iPhone es hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos, PDFs and text you import are read on this iPhone, by Apple's on-device model where the iPhone has it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos, los PDF y el texto que importas se leen en este iPhone, con el modelo en el dispositivo de Apple si el iPhone lo tiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos, PDF et textes que vous importez sont lus sur cet iPhone, par le modèle sur l’appareil d’Apple lorsque l’iPhone en dispose."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktardığın fotoğraflar, PDF'ler ve metinler bu iPhone'da okunur; iPhone'unda varsa Apple'ın cihaz üzerindeki modeliyle."
          }
        }
      }
    },
    "settings.privacy.local" : {
      "comment" : "Paragraph of the Privacy screen in a build without the assistant: what is typed into the app is not sent. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du in die App eingibst, wird nirgendwohin gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you type into the app is not sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que escribes en la app no se envía a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous saisissez dans l’app n’est envoyé nulle part."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamaya yazdıkların hiçbir yere gönderilmez."
          }
        }
      }
    },
    "settings.privacy.usage" : {
      "comment" : "Paragraph of the Privacy screen about optional usage analytics. Says what is sent and to whom, that it is pseudonymous rather than anonymous, what is never sent, and where to turn it off. Plain and exact: this is a legal disclosure.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Nutzungsanalysen gehen an PostHog: genutzte Funktionen, erreichte Grenzen und Kaufergebnisse, verknüpft mit einer zufälligen App-Kennung. Diese Daten sind pseudonym, nicht vollständig anonym. Sie enthalten nie Inhalte deiner Mahlzeiten oder Pläne. Die Standortanreicherung ist deaktiviert. Schalte das Teilen in den Einstellungen aus, um künftige Ereignisse zu stoppen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional usage analytics go to PostHog: feature events, limits and purchase outcomes, linked to a random app identifier. These are pseudonymous, not fully anonymous. They never include meal or plan content. Location enrichment is disabled. Turn sharing off in Settings to stop future events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de uso opcionales se envían a PostHog: funciones utilizadas, límites y resultados de compras, asociados a un identificador aleatorio de la app. Son datos seudónimos, no totalmente anónimos. Nunca incluyen el contenido de tus comidas o planes. La geolocalización está desactivada. Desactiva el envío en Ajustes para detener futuros eventos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données d’utilisation facultatives sont envoyées à PostHog : fonctionnalités utilisées, limites atteintes et résultats d’achat, associés à un identifiant aléatoire de l’app. Ces données sont pseudonymes, pas totalement anonymes. Elles n’incluent jamais le contenu de vos repas ou de vos plans. L’enrichissement par localisation est désactivé. Désactivez le partage dans Réglages pour arrêter les envois futurs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteğe bağlı kullanım analitiği PostHog’a gönderilir: özellik kullanımı, sınırlar ve satın alma sonuçları, rastgele bir uygulama kimliğiyle ilişkilendirilir. Veriler takma kimliklidir; tamamen anonim değildir. Öğün veya plan içeriğini içermez. Konum çıkarımı kapalıdır. Gelecekteki olayları durdurmak için Ayarlar’dan paylaşımı kapatabilirsin."
          }
        }
      }
    },
    "settings.privacy.widget" : {
      "comment" : "Privacy note, third paragraph: what the widget can see.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets zeigen deine nächsten Mahlzeiten auf dem Home-Bildschirm und dem Sperrbildschirm, wo jeder sie sehen kann, der dein iPhone in der Hand hält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets show your next meals on the Home Screen and Lock Screen, where anyone holding your phone can see them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los widgets muestran tus próximas comidas en la pantalla de inicio y de bloqueo, donde cualquiera con tu teléfono puede verlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les widgets affichent vos prochains repas sur l’écran d’accueil et l’écran de verrouillage, où toute personne tenant votre téléphone peut les voir."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget'lar sıradaki öğünlerini Ana Ekran'da ve Kilit Ekranı'nda gösterir; telefonunu tutan herkes görebilir."
          }
        }
      }
    },
