    "settings.privacy.import" : {
      "comment" : "Paragraph on the Privacy screen about importing a plan without the assistant. Names Apple's on-device model, which reads the text where the iPhone has it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos, PDFs and text you import are read on this iPhone, by Apple's on-device model where the iPhone has it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos, los PDF y el texto que importas se leen en este iPhone, con el modelo en el dispositivo de Apple si el iPhone lo tiene."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktardığın fotoğraflar, PDF'ler ve metinler bu iPhone'da okunur; iPhone'unda varsa Apple'ın cihaz üzerindeki modeliyle."
          }
        }
      }
    },
    "settings.privacy.local" : {
      "comment" : "Paragraph of the Privacy screen in a build without the assistant: what is typed into the app is not sent. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you type into the app is not sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que escribes en la app no se envía a ningún sitio."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamaya yazdıkların hiçbir yere gönderilmez."
          }
        }
      }
    },
    "settings.privacy.usage" : {
      "comment" : "Paragraph of the Privacy screen about anonymous usage data. Says what is sent, what never is, that it is not tied to the person, and where to turn it off. Plain and exact.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To help improve the app, it shares anonymous usage data: which features are used, where a limit is reached and whether a purchase was made. It is tied to a random number made on this iPhone, not to you or your Apple Account, and never includes your meals, your plan or anything you type. You can turn it off in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mejorar la app, se comparten datos de uso anónimos: qué funciones se usan, dónde se alcanza un límite y si se hizo una compra. Están asociados a un número aleatorio creado en este iPhone, no a ti ni a tu cuenta de Apple, y nunca incluyen tus comidas, tu plan ni nada de lo que escribes. Puedes desactivarlo en Ajustes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı geliştirmek için anonim kullanım verileri paylaşılır: hangi özelliklerin kullanıldığı, hangi sınıra ulaşıldığı ve satın alma yapılıp yapılmadığı. Bu veriler sana ya da Apple Hesabına değil, bu iPhone'da üretilen rastgele bir numaraya bağlıdır; öğünlerini, planını ya da yazdığın hiçbir şeyi içermez. Ayarlar'dan kapatabilirsin."
          }
        }
      }
    },
    "settings.privacy.widget" : {
      "comment" : "Privacy note, third paragraph: what the widget can see.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets show your next meals on the Home Screen and Lock Screen, where anyone holding your phone can see them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los widgets muestran tus próximas comidas en la pantalla de inicio y de bloqueo, donde cualquiera con tu teléfono puede verlas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
