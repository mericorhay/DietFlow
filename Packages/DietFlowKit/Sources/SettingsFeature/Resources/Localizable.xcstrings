    },
    "settings.privacy.body" : {
      "comment" : "First paragraph of the Privacy screen. %@ is the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your plan stays on this iPhone. %@ has no account and no advertising."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan se queda en este iPhone. %@ no tiene cuenta ni publicidad."
