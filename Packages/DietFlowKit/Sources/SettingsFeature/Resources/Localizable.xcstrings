    "settings.language.footer" : {
      "comment" : "Footer under the Language & Region section. %@ is the app's name. Explains that the language is chosen in Apple's Settings app and that dates, times and numbers follow the phone's region.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Sprache, die %@ verwendet, in der Einstellungen-App. Datum, Uhrzeit und Zahlen folgen der Region deines iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the language %@ uses in the Settings app. Dates, times and numbers follow your iPhone’s region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el idioma de %@ en la app Ajustes. Las fechas, las horas y los números siguen la región de tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la langue qu’utilise %@ dans l’app Réglages. Les dates, heures et nombres suivent la région de votre iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulamasının dilini Ayarlar uygulamasından seçebilirsin. Tarih, saat ve sayılar iPhone’unun bölge ayarına göre gösterilir."
          }
        }
      }
    },
