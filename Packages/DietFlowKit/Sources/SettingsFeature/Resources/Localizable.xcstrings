    "settings.deleteAll.message" : {
      "comment" : "Under the confirmation title: what is deleted, and that it cannot be undone. Two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your plans and everything you marked will be deleted. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán tus planes y todo lo que marcaste. Esta acción no se puede deshacer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planların ve işaretlediğin her şey silinir. Bu işlem geri alınamaz."
          }
        }
      }
    },
