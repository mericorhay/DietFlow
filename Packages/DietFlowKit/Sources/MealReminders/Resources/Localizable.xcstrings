          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me acabo de despertar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je me réveille"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni Kalktım"
          }
        }
      }
    },
    "notification.title.now" : {
      "comment" : "Title of a meal reminder notification sent at the meal's time. %@ is the meal type, such as 'Lunch'. Example: 'Lunch now'. The meal's name is the body.",
