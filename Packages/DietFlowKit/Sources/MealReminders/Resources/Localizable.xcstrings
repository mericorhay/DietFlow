    "notification.title.upcoming" : {
      "comment" : "Title of a meal reminder notification sent before a meal. %1$@ is the meal type, such as 'Lunch'; %2$@ is a duration such as '10 minutes' or '1 hour'. Example: 'Lunch in 10 minutes'. The meal's name is the body.",
