    "notification.action.wokeUp" : {
      "comment" : "Button on the day's first meal reminder notification. Says the person just got up, so the day's meal times move later to start from now. Works without opening the app. Short.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade aufgewacht"
