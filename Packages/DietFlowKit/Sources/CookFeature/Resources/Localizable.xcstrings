{
  "sourceLanguage" : "en",
  "strings" : {
    "cook.avoiding" : {
      "comment" : "Cook mode: chip showing the foods the person said they avoid (from Settings), as they typed them. %@ is their text, e.g. 'Avoiding: peanuts, milk'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoiding: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitando: %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaçındıkların: %@"
          }
        }
      }
    },
    "cook.chip.minutes" : {
      "comment" : "Cook mode: a short chip with a clock symbol giving minutes, for the whole recipe or one step. %lld is the number of minutes, e.g. '25 min'. Keep the abbreviation short.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dk"
          }
        }
      }
    },
    "cook.close" : {
      "comment" : "Cook mode: closes the screen. VoiceOver label of the X button at the top, and a button on the last page and in the error states.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapat"
          }
        }
      }
    },
    "cook.consent.message" : {
      "comment" : "Cook mode, under the consent card's title: exactly what is sent to the assistant. Must stay accurate: name, description, portion, and the foods the person avoids; nothing else.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To write the steps, the meal’s name, description and portion, and any foods you avoid, are sent to the assistant. Nothing else about you or your plan is sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escribir los pasos, se envían al asistente el nombre, la descripción y la porción de la comida, y los alimentos que evitas. No se envía nada más sobre ti ni sobre tu plan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adımları yazabilmesi için öğünün adı, açıklaması ve porsiyonu ile kaçındığın besinler asistana gönderilir. Seninle ya da planınla ilgili başka hiçbir şey gönderilmez."
          }
        }
      }
    },
    "cook.consent.title" : {
      "comment" : "Cook mode, before anything is sent: title of the card that asks to share this meal with the assistant so it can write the recipe. Tapping it opens the consent alert.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share this meal to get its recipe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte esta comida para recibir su receta"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarifini almak için bu öğünü paylaş"
          }
        }
      }
    },
    "cook.difficulty.easy" : {
      "comment" : "Cook mode: chip saying how hard the recipe is. One word.",
      "extractionState" : "manual",
      "localizations" : {
