    "cook.error.busy" : {
      "comment" : "Cook mode failure reason: too many requests just now.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The assistant is busy just now. Try again in a minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente está ocupado ahora. Inténtalo de nuevo en un minuto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistan şu an yoğun. Bir dakika sonra tekrar dene."
          }
        }
      }
    },
    "cook.error.dailyLimit" : {
      "comment" : "Cook mode failure reason: this phone reached the server's daily request limit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That is as many requests as one day allows. Try again tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado el máximo de solicitudes por día. Inténtalo mañana."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir günde yapılabilecek istek sayısına ulaştın. Yarın tekrar dene."
          }
        }
      }
    },
    "cook.error.noPlan" : {
      "comment" : "Cook mode failure reason: the assistant found nothing it could cook in the meal's name and description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The assistant could not find a dish to cook in this meal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente no encontró un plato que cocinar en esta comida."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistan bu öğünde pişirilecek bir yemek bulamadı."
          }
        }
      }
    },
    "cook.error.offline" : {
      "comment" : "Cook mode failure reason: the assistant could not be reached.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The assistant could not be reached. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con el asistente. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistana ulaşılamadı. Bağlantını kontrol edip tekrar dene."
          }
        }
      }
    },
    "cook.error.tooLong" : {
      "comment" : "Cook mode failure reason: the meal's description is longer than the assistant reads at once.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This meal’s description is longer than the assistant reads at once. Shorten it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descripción de esta comida es más larga de lo que el asistente lee de una vez. Acórtala e inténtalo de nuevo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu öğünün açıklaması asistanın tek seferde okuyabileceğinden uzun. Kısaltıp tekrar dene."
          }
        }
      }
    },
    "cook.error.unavailable" : {
      "comment" : "Cook mode failure reason: the service is down or answered with something unreadable.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The assistant is not available right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente no está disponible ahora."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistan şu an kullanılamıyor."
          }
        }
      }
    },
    "cook.failed.notCounted" : {
      "comment" : "Cook mode, under a failure reason: reassures that the failed attempt did not use one of the month's assistant uses.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing was taken from your AI uses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se descontó ningún uso del asistente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistan hakkından bir şey düşülmedi."
          }
        }
      }
    },
    "cook.failed.title" : {
      "comment" : "Cook mode: title when the recipe could not be written (no connection, service busy…). A reason and a Try Again button follow.",
