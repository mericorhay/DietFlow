    "onboarding.plan.message" : {
      "comment" : "First onboarding page, the line under the title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build or import your meal schedule."
