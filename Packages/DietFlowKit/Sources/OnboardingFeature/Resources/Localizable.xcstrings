    "onboarding.setup.message" : {
      "comment" : "Under the title of the introduction page where the widget is chosen and colored. Two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a widget, its color and its tone. You can change them any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un widget, su color y su tono. Puedes cambiarlos cuando quieras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget'ı, rengini ve tonunu seç. İstediğin zaman değiştirebilirsin."
          }
        }
      }
    },
    "onboarding.setup.title" : {
      "comment" : "Title of the introduction page where the widget's kind, color and tone are chosen. A short sentence, three words at most.",
