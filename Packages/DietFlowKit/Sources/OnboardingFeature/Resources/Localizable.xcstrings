{
  "sourceLanguage" : "en",
  "strings" : {
    "onboarding.add.edit" : {
      "comment" : "Label of the Edit button drawn on the small picture of a Home Screen; the same word iOS uses there. One word.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenle"
          }
        }
      }
    },
    "onboarding.add.message" : {
      "comment" : "Under the title of the last introduction page. The steps themselves are shown in the animation above. Two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three steps, once. After that it keeps itself up to date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres pasos, una sola vez. Después se mantiene al día solo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üç adım, bir kez. Sonrasında kendiliğinden güncel kalır."
          }
        }
      }
    },
    "onboarding.add.step1" : {
      "comment" : "Caption of step 1 in the animation that shows how to add the widget. A few words, no period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold an empty spot"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un espacio vacío"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş bir yere basılı tut"
          }
        }
      }
    },
    "onboarding.add.step2" : {
      "comment" : "Caption of step 2 in the animation that shows how to add the widget. Edit and Add Widget are the names of iOS's own buttons. A few words, no period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Edit, then Add Widget"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Editar y luego Añadir widget"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenle'ye, sonra Widget Ekle'ye dokun"
          }
        }
      }
    },
    "onboarding.add.step3" : {
      "comment" : "Caption of step 3 in the animation that shows how to add the widget. %@ is the app's name. A few words, no period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulamasını seç"
          }
        }
      }
    },
    "onboarding.add.title" : {
      "comment" : "Title of the last introduction page, which shows how to add the widget to the Home Screen. A short sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put it on your Home Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponlo en tu pantalla de inicio."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Ekran'ına koy."
          }
        }
      }
    },
    "onboarding.continue" : {
      "comment" : "Button that goes to the next onboarding page. One word.",
