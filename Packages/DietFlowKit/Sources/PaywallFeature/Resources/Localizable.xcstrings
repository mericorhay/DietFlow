    "paywall.subtitle.limit" : {
      "comment" : "Under the title on the Plus screen when the free monthly allowance of assistant plans is used up. %1$lld is that allowance (a small number), %2$@ the date it comes back (\"1 November\"), %3$lld what Plus includes a month.",
