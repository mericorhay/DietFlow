{
  "sourceLanguage" : "en",
  "strings" : {
    "paywall.autoRenew" : {
      "comment" : "Small print under the price for the two subscriptions; App Review requires it. The path names Apple's own Settings screens.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions renew automatically until cancelled. Cancel at least a day before renewal in Settings › Apple Account › Subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente hasta que se cancelan. Cancela al menos un día antes de la renovación en Ajustes › Cuenta de Apple › Suscripciones."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelikler iptal edilene kadar otomatik yenilenir. Yenilenmeden en az bir gün önce Ayarlar › Apple Hesabı › Abonelikler bölümünden iptal edebilirsin."
          }
        }
      }
    },
    "paywall.badge.saving" : {
      "comment" : "Small badge beside 'Yearly': how much less it costs than twelve months. %@ is a percentage (\"48%\").",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahorra %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tasarruf"
          }
        }
      }
    },
    "paywall.badge.trial" : {
      "comment" : "Small badge beside a product that starts with a free trial. %@ is its length (\"7 days\").",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ free"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gratis"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ücretsiz"
          }
        }
      }
    },
    "paywall.benefit.create.message" : {
      "comment" : "Under 'A plan written for you'. One sentence. 30 is the most days it writes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say how you eat and what you avoid, and get up to 30 days of meals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di cómo comes y qué evitas, y recibe hasta 30 días de comidas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasıl beslendiğini ve nelerden kaçındığını söyle, 30 güne kadar öğünlerin hazır olsun."
          }
        }
      }
    },
    "paywall.benefit.create.title" : {
      "comment" : "Heading of a benefit row on the Plus screen: the assistant writes a new plan. A few words.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A plan written for you"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plan escrito para ti"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana özel yazılmış plan"
          }
        }
      }
    },
    "paywall.benefit.free.message" : {
      "comment" : "Under 'Free, for good'. Lists what the free version includes. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One plan, every widget and meal reminders never need Plus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plan, todos los widgets y los recordatorios de comidas no necesitan Plus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek plan, tüm widget'lar ve öğün hatırlatmaları için Plus gerekmez."
          }
        }
      }
    },
    "paywall.benefit.free.title" : {
      "comment" : "Heading of the last, quieter row on the Plus screen: what never needs paying for. A few words.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free, for good"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis para siempre"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hep ücretsiz"
          }
        }
      }
    },
    "paywall.benefit.organize.message" : {
      "comment" : "Under 'Any list, put in order'. What the person does and what they get. Two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste a dietitian's message or your own notes, however messy. The assistant sorts it into days and meals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega el mensaje de tu dietista o tus notas, por desordenadas que estén. El asistente lo ordena en días y comidas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diyetisyeninin mesajını ya da kendi notlarını, ne kadar dağınık olursa olsun yapıştır. Asistan günlere ve öğünlere ayırır."
          }
        }
      }
    },
    "paywall.benefit.organize.title" : {
      "comment" : "Heading of a benefit row on the Plus screen: the assistant tidies up a pasted list. A few words.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any list, put in order"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier lista, en orden"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her liste düzene girer"
          }
        }
      }
    },
    "paywall.benefit.plans.message" : {
      "comment" : "Under 'More than one plan'. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this month's plan and the next one side by side, and switch whenever you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el plan de este mes y el siguiente, y cambia cuando quieras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayın planını ve sonrakini yan yana tut, istediğin zaman geçiş yap."
          }
        }
      }
    },
    "paywall.benefit.plans.title" : {
      "comment" : "Heading of a benefit row on the Plus screen: keeping several meal plans. A few words.",
