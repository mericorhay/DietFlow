    "import.assistant.error.busy" : {
      "comment" : "Alert message when the assistant has too many requests at the moment. Two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent ist gerade beschäftigt. Versuche es in einer Minute erneut."
