    "import.assistant.privacy" : {
      "comment" : "Footer under the assistant's rows on Import Plan. %@ is the company whose AI the assistant uses, such as OpenAI. Says where the text goes. Three short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent wird von %@ betrieben. Was du ihm gibst, wird dafür über unseren Server dorthin gesendet. Wir speichern es nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The assistant is powered by %@. What you give it is sent there through our server to be read. We do not store it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente funciona con la IA de %@. Lo que le das se envía allí a través de nuestro servidor para leerlo. Nosotros no lo guardamos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant fonctionne avec %@. Ce que vous lui donnez y est envoyé via notre serveur pour être lu. Nous ne le conservons pas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistan %@ yapay zekâsıyla çalışır. Ona verdiğin metin, okunmak üzere sunucumuz üzerinden oraya gönderilir. Biz saklamayız."
          }
        }
      }
    },
