    "import.assistant.consent.message" : {
      "comment" : "Message of the alert shown before text is first sent to the assistant. %1$@ is the company whose AI reads the text, %2$@ is this app's name. Three short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um deinen Plan zu schreiben, wird der eingegebene Text über unseren Server an %1$@ gesendet, dessen KI ihn liest. %2$@ speichert ihn nicht. Lass alles weg, was du nicht teilen möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To write your plan, the text you entered is sent through our server to %1$@, whose AI reads it. %2$@ does not store it. Leave out anything you would not want shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escribir tu plan, el texto que has introducido se envía a través de nuestro servidor a %1$@, cuya IA lo lee. %2$@ no lo guarda. No incluyas nada que no quieras compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour rédiger votre plan, le texte saisi est envoyé via notre serveur à %1$@, dont l’IA le lit. %2$@ ne le conserve pas. Évitez d’y mettre ce que vous ne voudriez pas partager."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planını yazabilmek için girdiğin metin, sunucumuz üzerinden %1$@ şirketine gönderilir; metni onun yapay zekâsı okur. %2$@ bu metni saklamaz. Paylaşılmasını istemediğin şeyleri yazma."
          }
        }
      }
    },
    "import.assistant.consent.title" : {
      "comment" : "Title of the alert shown before text is first sent to the assistant. %@ is the company whose AI reads it, such as OpenAI. A short question.",
      "extractionState" : "manual",
      "localizations" : {
