    "import.assistant.allowance" : {
      "comment" : "Footer under the assistant's rows: how many requests are left this period and when the count starts again. %1$lld is what is left, %2$lld the allowance, %3$@ a date (\"1 November\").",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übrig: %1$lld von %2$lld. Am %3$@ sind sie wieder da."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left: %1$lld of %2$lld. They come back on %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedan %1$lld de %2$lld. Vuelven el %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restantes : %1$lld sur %2$lld. Elles reviennent le %3$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalan: %2$lld üzerinden %1$lld. %3$@ tarihinde yenilenir."
          }
        }
      }
    },
