    "import.assistant.create.disclaimer" : {
      "comment" : "Footer under the text box, before the assistant is asked for a plan. Must stay plain and unhedged: not medical advice. Two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The assistant writes everyday meal plans, not medical advice. If you have a health condition, check with your doctor or dietitian before changing how you eat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente escribe planes de comidas cotidianos, no da consejo médico. Si tienes un problema de salud, consulta a tu médico o dietista antes de cambiar tu alimentación."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistan günlük öğün planı yazar, tıbbi tavsiye vermez. Bir sağlık sorunun varsa beslenmeni değiştirmeden önce doktoruna ya da diyetisyenine danış."
          }
        }
      }
    },
