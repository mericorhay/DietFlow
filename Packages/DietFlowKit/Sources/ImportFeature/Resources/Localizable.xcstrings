    "import.ai.footer" : {
      "comment" : "Explains how to use the copied instructions. One or two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die Anweisungen zusammen mit deinem Plan in den Chat ein und füge dann die Antwort hier mit „Plan einfügen“ ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste the instructions into the chat along with your plan, then paste the reply here with Paste Plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega las instrucciones en el chat junto con tu plan y luego pega aquí la respuesta con Pegar plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez les instructions dans la discussion avec votre plan, puis collez la réponse ici avec Coller le plan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talimatları planınla birlikte sohbete yapıştır, sonra gelen cevabı Planı Yapıştır ile buraya ekle."
          }
        }
      }
    },
