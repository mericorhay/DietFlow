    "intent.markDone.description" : {
      "comment" : "Description of the Mark Meal Done action in Shortcuts. One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marks a meal as eaten. Without a choice, it marks the meal that is on now or next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca una comida como hecha. Si no eliges ninguna, marca la de ahora o la siguiente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir öğünü yendi olarak işaretler. Seçim yapılmazsa şu anki veya sıradaki öğünü işaretler."
          }
        }
      }
    },
