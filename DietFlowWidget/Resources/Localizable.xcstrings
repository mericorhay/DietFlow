          }
        }
      }
    },
    "intent.unmark.description" : {
      "comment" : "App Intent description (Shortcuts) for taking back the mark on a meal.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
