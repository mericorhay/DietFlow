    "widget.progress.description" : {
      "comment" : "Widget gallery: description of the Day Progress widget.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ring, der sich füllt, während deine Mahlzeiten vergehen, mit der nächsten direkt darunter."
          }
