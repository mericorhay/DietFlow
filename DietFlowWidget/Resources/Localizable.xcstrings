    "widget.nextMeal.description" : {
      "comment" : "Widget gallery: description of the Next Meal widget, under its name. One or two short sentences that make people want it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine nächste Mahlzeit und ihre Uhrzeit, immer im Blick. Markiere sie direkt auf deinem Home-Bildschirm als gegessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your next meal and its time, always in sight. Mark it eaten right from your Home Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu próxima comida y su hora, siempre a la vista. Márcala como hecha desde la pantalla de inicio."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıradaki öğünün ve saati hep gözünün önünde. Ana Ekran'dan tek dokunuşla Yedim de."
          }
        }
      }
    },
