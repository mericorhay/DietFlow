{
  "sourceLanguage" : "en",
  "strings" : {
    "control.markEaten.description" : {
      "comment" : "Control Center control: description in the controls gallery.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiert die aktuelle oder nächste Mahlzeit als gegessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marks the meal that’s on now, or the next one, as eaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca como hecha la comida de ahora o la siguiente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anki ya da sıradaki öğünü yedim olarak işaretler."
          }
        }
      }
    },
    "control.markEaten.label" : {
