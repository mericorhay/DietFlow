    "control.startDay.description" : {
      "comment" : "Control Center control: description in the controls gallery.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für späte Morgen: Die heutigen Mahlzeiten starten ab jetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mornings that start late: today’s meals move to start from now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mañanas que empiezan tarde: las comidas de hoy empiezan desde ahora."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geç başlayan sabahlar için: bugünün öğünleri şimdiden başlar."
          }
        }
      }
    },
    "control.startDay.label" : {
      "comment" : "Control Center control: the label on the button itself.",
